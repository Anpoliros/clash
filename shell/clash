#!/usr/bin/env bash
# clash 单入口：管理 mihomo 启停、日志、状态和订阅配置。
# 修改时间：2026-07-28 18:15:12 +08:00

# #----路径定位----
if [ -n "${ZSH_VERSION:-}" ]; then
    SCRIPT_PATH="${(%):-%x}"
elif [ -n "${BASH_SOURCE[0]:-}" ]; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
else
    SCRIPT_PATH="$0"
fi

SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CLASH_DIR="${CLASH_DIR:-$PROJECT_DIR/mihomo}"
CLASH_BIN="${CLASH_BIN:-$CLASH_DIR/mihomo-linux-amd64-v1}"
CONFIG_FILE="${CLASH_CONFIG:-$CLASH_DIR/config.yaml}"
PID_FILE="${CLASH_PID:-$CLASH_DIR/mihomo.pid}"
LOGS_DIR="${CLASH_LOGS_DIR:-$PROJECT_DIR/logs}"
LOG_FILE="${CLASH_LOG:-$LOGS_DIR/mihomo/current.log}"
TUI_DIR="${CLASH_TUI_DIR:-$PROJECT_DIR/tui}"
TUI_BIN_DIR="${CLASH_TUI_BIN_DIR:-$PROJECT_DIR/bin}"
TUI_BIN="$TUI_BIN_DIR/clash-tui"
CONFIG_TOOL="$SCRIPT_DIR/config.py"
ARCHIVE_TOOL="$SCRIPT_DIR/archive.py"
CACHE_TOOL="$SCRIPT_DIR/provider_cache.py"
PYTHON_BIN="${CLASH_PYTHON:-python3}"
STATE_LOCK_DIR="$CLASH_DIR/.clash.lock"
DEFAULT_PROXY_PORT=7890

return_or_exit() {
    local code="${1:-0}"
    return "$code" 2>/dev/null || exit "$code"
}

is_sourced() {
    [ "${BASH_SOURCE[0]:-}" != "$0" ] || [ -n "${ZSH_EVAL_CONTEXT:-}" ]
}

die() {
    echo "clash: $*" >&2
    return_or_exit 1
}

info() {
    echo "$*"
}

quiet() {
    [ "${CLASH_QUIET:-0}" = "1" ]
}

# #----状态锁----
acquire_state_lock() {
    local waited=0
    mkdir -p "$CLASH_DIR" || return 1
    while ! mkdir "$STATE_LOCK_DIR" 2>/dev/null; do
        waited=$((waited + 1))
        [ "$waited" -le 20 ] || die "clash 状态锁超时：$STATE_LOCK_DIR"
        sleep 0.2
    done
}

release_state_lock() {
    rmdir "$STATE_LOCK_DIR" 2>/dev/null || true
}

with_state_lock() {
    acquire_state_lock || return 1
    "$@"
    local code=$?
    release_state_lock
    return "$code"
}

# #----配置工具----
require_config_tool() {
    command -v "$PYTHON_BIN" >/dev/null 2>&1 || die "需要 Python 3：$PYTHON_BIN"
    [ -f "$CONFIG_TOOL" ] || die "配置工具不存在：$CONFIG_TOOL"
}

config_tool() {
    require_config_tool || return 1
    "$PYTHON_BIN" "$CONFIG_TOOL" --config "$CONFIG_FILE" "$@"
}

config_get() {
    config_tool get "$1" 2>/dev/null
}

config_update() {
    require_config_tool || return 1
    if [ -x "$CLASH_BIN" ]; then
        "$PYTHON_BIN" "$CONFIG_TOOL" --config "$CONFIG_FILE" --home "$CLASH_DIR" --validator "$CLASH_BIN" --logs-dir "$LOGS_DIR" "$@"
    else
        "$PYTHON_BIN" "$CONFIG_TOOL" --config "$CONFIG_FILE" --home "$CLASH_DIR" --logs-dir "$LOGS_DIR" "$@"
    fi
}

archive_tool() {
    require_config_tool || return 1
    [ -f "$ARCHIVE_TOOL" ] || die "归档工具不存在：$ARCHIVE_TOOL"
    "$PYTHON_BIN" "$ARCHIVE_TOOL" --logs-dir "$LOGS_DIR" "$@"
}

cache_tool() {
    require_config_tool || return 1
    [ -f "$CACHE_TOOL" ] || die "缓存工具不存在：$CACHE_TOOL"
    "$PYTHON_BIN" "$CACHE_TOOL" --config "$CONFIG_FILE" --home "$CLASH_DIR" --logs-dir "$LOGS_DIR" "$@"
}

json_quote() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    printf '"%s"' "$value"
}

reload_running_config() {
    is_running || return 0
    command -v curl >/dev/null 2>&1 || {
        die "mihomo 正在运行，但缺少 curl，无法热加载配置"
        return 1
    }

    local controller secret config_path payload response http_status body
    controller="$(config_get controller)"
    [ -n "$controller" ] || controller="127.0.0.1:9090"
    case "$controller" in
        http://*|https://*) ;;
        *) controller="http://$controller" ;;
    esac
    controller="${controller%/}"

    config_path="$(cd "$(dirname "$CONFIG_FILE")" && pwd)/$(basename "$CONFIG_FILE")"
    payload="{\"path\":$(json_quote "$config_path"),\"payload\":\"\"}"
    secret="$(config_get secret)"

    if [ -n "$secret" ]; then
        response="$(curl --silent --show-error --noproxy '*' --connect-timeout 3 --max-time 30 \
            --request PUT \
            --header "Authorization: Bearer $secret" \
            --header "Content-Type: application/json" \
            --data "$payload" \
            --write-out $'\n%{http_code}' \
            "$controller/configs?force=true")" || return 1
    else
        response="$(curl --silent --show-error --noproxy '*' --connect-timeout 3 --max-time 30 \
            --request PUT \
            --header "Content-Type: application/json" \
            --data "$payload" \
            --write-out $'\n%{http_code}' \
            "$controller/configs?force=true")" || return 1
    fi

    http_status="${response##*$'\n'}"
    body="${response%$'\n'*}"
    case "$http_status" in
        2??) info "mihomo 配置已热加载" ;;
        *)
            [ -n "$body" ] || body="无响应内容"
            die "mihomo 热加载失败（HTTP $http_status）：$body"
            return 1
            ;;
    esac
}

fallback_tun_enabled() {
    awk '
        /^[[:space:]]*tun:[[:space:]]*$/ { in_tun = 1; next }
        in_tun && /^[^[:space:]]/ { in_tun = 0 }
        in_tun && /^[[:space:]]*enable:[[:space:]]*/ {
            gsub(/[[:space:]]/, "", $2)
            print $2
            exit
        }
    ' "$CONFIG_FILE" 2>/dev/null
}

proxy_port() {
    local port
    port="$(config_get proxy-port)"
    printf '%s' "${port:-$DEFAULT_PROXY_PORT}"
}

set_tun_enabled() {
    local enabled="$1"
    config_update set tun-enabled "$enabled" >/dev/null
}

# #----运行状态----
pid_value() {
    [ -f "$PID_FILE" ] && tr -d '[:space:]' < "$PID_FILE"
}

is_running() {
    local pid
    pid="$(pid_value)"
    if [ -n "$pid" ] && ps -p "$pid" >/dev/null 2>&1; then
        return 0
    fi
    [ -n "$(own_mihomo_pids)" ]
}

own_mihomo_pids() {
    ps -eo pid=,args= | awk -v project="$PROJECT_DIR" -v work="$CLASH_DIR" '
        /mihomo/ && (index($0, "-d " work) || index($0, "-d " project)) {
            print $1
        }
    '
}

running_mode() {
    local tun
    tun="$(config_get tun-enabled)"
    [ -n "$tun" ] || tun="$(fallback_tun_enabled)"
    if [ "$tun" = "true" ]; then
        printf 'tun'
    else
        printf 'normal'
    fi
}

short_status() {
    if is_running; then
        local pids
        pids="$(own_mihomo_pids | paste -sd, -)"
        [ -n "$pids" ] || pids="$(pid_value)"
        info "mihomo running | pid=$pids | mode=$(running_mode) | port=$(proxy_port)"
    else
        info "mihomo stopped | mode=$(running_mode) | port=$(proxy_port)"
    fi
}

status_detail() {
    short_status
    echo
    echo "Paths"
    echo "  project: $PROJECT_DIR"
    echo "  mihomo:  $CLASH_DIR"
    echo "  bin:     $CLASH_BIN"
    echo "  tui:     $TUI_BIN"
    echo "  config: $CONFIG_FILE"
    echo "  pid:     $PID_FILE"
    echo "  log:     $LOG_FILE"
    echo
    echo "Config"
    echo "  http:       $(config_get port)"
    echo "  mixed:      $(config_get mixed-port)"
    echo "  socks:      $(config_get socks-port)"
    echo "  controller: $(config_get external-controller)"
    echo "  tun:        $(config_get tun-enabled)"
    echo "  providers:  $(config_get provider-names || true)"
    echo
    echo "Shell"
    echo "  http_proxy:  ${http_proxy:-"-"}"
    echo "  https_proxy: ${https_proxy:-"-"}"
    if [ -f "$LOG_FILE" ]; then
        echo
        echo "Log"
        echo "  size: $(du -h "$LOG_FILE" 2>/dev/null | awk '{print $1}')"
        echo "  time: $(stat -c '%y' "$LOG_FILE" 2>/dev/null | cut -d'.' -f1)"
    fi
}

# #----启停控制----
prepare_log_user() {
    if [ -n "${CLASH_LOG:-}" ]; then
        mkdir -p "$(dirname "$LOG_FILE")" || return 1
        if [ -e "$LOG_FILE" ] && [ ! -w "$LOG_FILE" ]; then
            sudo chown "$(id -u):$(id -g)" "$LOG_FILE" 2>/dev/null || return 1
        fi
        : > "$LOG_FILE" || return 1
    else
        LOG_FILE="$(archive_tool runtime create)" || return 1
    fi
}

export_proxy_env() {
    local port
    port="$(proxy_port)"
    export http_proxy="127.0.0.1:$port"
    export https_proxy="$http_proxy"
    export HTTP_PROXY="$http_proxy"
    export HTTPS_PROXY="$http_proxy"
}

unset_proxy_env() {
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
}

proxy_env_signature() {
    local config_stamp pid state
    config_stamp="$(stat -c '%y:%s:%i' "$CONFIG_FILE" 2>/dev/null || printf 'missing')"
    pid="$(pid_value)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        state="running"
    else
        state="stopped"
    fi
    printf '%s|%s|%s' "$config_stamp" "$pid" "$state"
}

_clash_auto_env() {
    CLASH_QUIET=1 sync_env_if_changed
}

register_proxy_env_hook() {
    local hook
    if [ -n "${ZSH_VERSION:-}" ]; then
        autoload -Uz add-zsh-hook
        add-zsh-hook -d precmd _clash_auto_env 2>/dev/null || true
        add-zsh-hook precmd _clash_auto_env
    elif [ -n "${BASH_VERSION:-}" ]; then
        if declare -p PROMPT_COMMAND 2>/dev/null | command grep -q 'declare -a'; then
            for hook in "${PROMPT_COMMAND[@]}"; do
                [ "$hook" = "_clash_auto_env" ] && return 0
            done
            PROMPT_COMMAND+=(_clash_auto_env)
        else
            case ";${PROMPT_COMMAND:-};" in
                *';_clash_auto_env;'*) ;;
                *) PROMPT_COMMAND="_clash_auto_env${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
            esac
        fi
    fi
}

sync_env() {
    if is_running && [ "$(running_mode)" = "normal" ]; then
        export_proxy_env
        quiet || info "proxy env enabled: $http_proxy"
    else
        unset_proxy_env
        quiet || info "proxy env cleared"
    fi
    CLASH_ENV_SIGNATURE="$(proxy_env_signature)"
}

sync_env_if_changed() {
    local signature
    signature="$(proxy_env_signature)"
    if [ "${CLASH_ENV_SIGNATURE:-}" = "$signature" ]; then
        return 0
    fi
    sync_env
}

start_normal() {
    [ -x "$CLASH_BIN" ] || die "mihomo 二进制不可执行：$CLASH_BIN"
    if is_running; then
        sync_env
        register_proxy_env_hook
        short_status
        return 0
    fi

    set_tun_enabled false || return 1
    prepare_log_user || die "无法写入日志：$LOG_FILE"
    nohup "$CLASH_BIN" -d "$CLASH_DIR" > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    export_proxy_env
    CLASH_ENV_SIGNATURE="$(proxy_env_signature)"
    register_proxy_env_hook
    info "mihomo started (normal) | pid=$(pid_value) | proxy=$http_proxy"
}

start_tun() {
    [ -x "$CLASH_BIN" ] || die "mihomo 二进制不可执行：$CLASH_BIN"
    if is_running; then
        short_status
        return 0
    fi

    set_tun_enabled true || return 1
    prepare_log_user || die "无法创建运行日志：$LOGS_DIR/mihomo"
    info "[sudo] TUN 模式需要权限，正在验证..."
    sudo -v || return 1
    if is_running; then
        short_status
        return 0
    fi
    sudo bash -c "cd '$CLASH_DIR' && nohup '$CLASH_BIN' -d '$CLASH_DIR' > '$LOG_FILE' 2>&1 & echo \$! > '$PID_FILE'"
    unset_proxy_env
    CLASH_ENV_SIGNATURE="$(proxy_env_signature)"
    info "mihomo started (tun) | pid=$(pid_value)"
}

stop_clash() {
    local pids pid alive
    pids="$(own_mihomo_pids)"
    pid="$(pid_value)"
    if [ -n "$pid" ] && ps -p "$pid" >/dev/null 2>&1 && ! printf '%s\n' "$pids" | grep -qx "$pid"; then
        pids="${pids:+$pids
}$pid"
    fi

    if [ -z "$pids" ]; then
        info "mihomo already stopped"
    else
        info "Stopping mihomo pids: $(printf '%s\n' "$pids" | paste -sd, -)"
        while IFS= read -r pid; do
            [ -n "$pid" ] || continue
            kill "$pid" 2>/dev/null || sudo kill "$pid" 2>/dev/null || true
        done <<EOF
$pids
EOF
        sleep 1

        alive=""
        while IFS= read -r pid; do
            [ -n "$pid" ] || continue
            if ps -p "$pid" >/dev/null 2>&1; then
                alive="${alive:+$alive
}$pid"
            fi
        done <<EOF
$pids
EOF

        if [ -n "$alive" ]; then
            info "[sudo] 强制停止残留 mihomo：$(printf '%s\n' "$alive" | paste -sd, -)"
            while IFS= read -r pid; do
                [ -n "$pid" ] || continue
                kill -9 "$pid" 2>/dev/null || sudo kill -9 "$pid" 2>/dev/null || true
            done <<EOF
$alive
EOF
        fi
    fi

    rm -f "$PID_FILE" 2>/dev/null || sudo rm -f "$PID_FILE" 2>/dev/null
    unset_proxy_env
    CLASH_ENV_SIGNATURE="$(proxy_env_signature)"
}

show_log() {
    if [ ! -f "$LOG_FILE" ]; then
        info "日志不存在：$LOG_FILE"
        return 0
    fi
    if command -v less >/dev/null 2>&1; then
        less +F "$LOG_FILE"
    else
        tail -f "$LOG_FILE"
    fi
}

# #----订阅配置----
usage_config() {
    cat <<'EOF'
用法：
  clash config add 名称 (-u 订阅链接 | -f 本地文件) [-p 托管路径] [-g 策略组]
  clash config ls
  clash config rm 名称
  clash config set-url 名称 -u 新订阅链接
  clash config cache-update [名称 ...]
  clash config cache-clean

示例：
  clash config add airport -u https://example.com/sub.yaml
  clash config add local -f ~/Downloads/local.yaml
  clash config add local -f ~/Downloads/local.yaml -p ./providers/custom.yaml
  clash config rm airport
  clash config set-url airport -u https://example.com/new-sub.yaml
  clash config cache-update
  clash config cache-clean
EOF
}

config_add() {
    case "${1:-}" in
        -h|--help) usage_config; return 0 ;;
    esac
    mkdir -p "$CLASH_DIR/providers"
    config_update provider add "$@" || return 1
    reload_running_config || {
        die "Provider 已写入 config.yaml，但运行中的 mihomo 未能加载新配置"
        return 1
    }
}

config_ls() {
    if is_running; then
        cache_tool list
    else
        config_tool provider ls
    fi
}

config_rm() {
    case "${1:-}" in
        -h|--help) usage_config; return 0 ;;
    esac
    config_update provider rm "$@" || return 1
    reload_running_config || {
        die "Provider 已从 config.yaml 移除，但运行中的 mihomo 未能加载新配置"
        return 1
    }
}

config_set_url() {
    case "${1:-}" in
        -h|--help) usage_config; return 0 ;;
    esac
    config_update provider set-url "$@" || return 1
    reload_running_config || {
        die "Provider URL 已更新，但运行中的 mihomo 未能加载新配置"
        return 1
    }
}

config_cache_update() {
    if ! is_running; then
        die "mihomo 未运行，无法通过 Provider API 更新缓存"
        return 1
    fi
    cache_tool update "$@"
}

config_cache_clean() {
    cache_tool clean
}

config_cmd() {
    local sub="${1:-}"
    shift || true
    case "$sub" in
        add) config_add "$@" ;;
        ls|list) config_ls ;;
        rm|remove) config_rm "$@" ;;
        set-url) config_set_url "$@" ;;
        cache-update) config_cache_update "$@" ;;
        cache-clean) config_cache_clean ;;
        -h|--help|help) usage_config ;;
        *) usage_config; return 1 ;;
    esac
}

# #----TUI----
usage_tui() {
    cat <<'EOF'
Usage:
  clash tui [ARGS]    Run the built TUI binary, forwarding ARGS
  clash tui --dev     Run TUI through cargo run
  clash tui --build   Build TUI release binary
  clash tui --clean   Clean TUI cargo cache only
  clash tui --download rustup
  clash tui --download VERSION [--github|--gitea]
EOF
}

require_tui_dir() {
    [ -d "$TUI_DIR" ] || die "TUI 目录不存在：$TUI_DIR"
    [ -f "$TUI_DIR/Cargo.toml" ] || die "TUI Cargo.toml 不存在：$TUI_DIR/Cargo.toml"
}

require_cargo() {
    command -v cargo >/dev/null 2>&1 || die "需要 cargo 才能构建或开发运行 TUI"
}

tui_dev() {
    require_tui_dir || return 1
    require_cargo || return 1
    if [ "$#" -eq 0 ]; then
        set -- -d "$CLASH_DIR"
    fi
    (cd "$TUI_DIR" && cargo run -- "$@")
}

tui_build() {
    require_tui_dir || return 1
    require_cargo || return 1

    (cd "$TUI_DIR" && cargo build --release) || return 1
    mkdir -p "$TUI_BIN_DIR" || return 1
    cp "$TUI_DIR/target/release/clash-tui" "$TUI_BIN" || return 1
    chmod +x "$TUI_BIN" || return 1
    info "TUI built: $TUI_BIN"
}

tui_run() {
    require_tui_dir || return 1
    [ -x "$TUI_BIN" ] || die "TUI 尚未安装：请先运行 clash tui --build 或 ./shell/download.sh"
    if [ "$#" -eq 0 ]; then
        set -- -d "$CLASH_DIR"
    fi
    (cd "$TUI_DIR" && "$TUI_BIN" "$@")
}

tui_clean() {
    require_tui_dir || return 1
    require_cargo || return 1

    (cd "$TUI_DIR" && cargo clean) || return 1
    info "TUI cargo cache cleaned"
}

tui_download() {
    "$SCRIPT_DIR/download.sh" "$@"
}

tui_cmd() {
    local opt="${1:-}"
    case "$opt" in
        "") tui_run ;;
        --dev) shift; tui_dev "$@" ;;
        --build) tui_build ;;
        --clean) tui_clean ;;
        --download) shift; tui_download "$@" ;;
        -h|--help|help) usage_tui ;;
        *) tui_run "$@" ;;
    esac
}

# #----帮助----
usage() {
    cat <<'EOF'
用法：
  clash                 显示简要状态
  clash status          显示详细状态
  clash on              普通模式启动 mihomo，并导出代理环境变量
  clash tun             TUN 模式启动 mihomo，会先进行 sudo 验证
  clash off             停止 mihomo，并清理代理环境变量
  clash env             根据 mihomo 状态同步当前 shell 的代理环境变量
  clash log             使用 less +F 跟随最近一次运行日志
  clash tui             运行、构建或开发终端界面
  clash config add      添加订阅 Provider 到 config.yaml
  clash config ls       列出订阅 Provider、余额和到期日期
  clash config rm       从 config.yaml 移除订阅 Provider
  clash config set-url  修改 HTTP Provider 的订阅链接
  clash config cache-update  主动更新 HTTP Provider 缓存
  clash config cache-clean   将可清理缓存安全归档到 logs

更多帮助：
  clash tui -h
  clash config -h
EOF
}

# #----主入口----
main() {
    local cmd="${1:-}"
    if [ $# -gt 0 ]; then
        shift
    fi

    case "$cmd" in
        "") short_status ;;
        on) with_state_lock start_normal ;;
        tun) with_state_lock start_tun ;;
        off) with_state_lock stop_clash ;;
        env)
            sync_env
            register_proxy_env_hook
            ;;
        status) status_detail ;;
        log) show_log ;;
        tui) tui_cmd "$@" ;;
        config) with_state_lock config_cmd "$@" ;;
        help|-h|--help) usage ;;
        *) usage; return 1 ;;
    esac
}

main "$@"
