#!/usr/bin/env bash
# clash 单入口：管理 mihomo 启停、日志、状态和订阅配置。

# #----路径定位----
if [ -n "${ZSH_VERSION:-}" ]; then
    SCRIPT_PATH="${(%):-%x}"
elif [ -n "${BASH_SOURCE[0]:-}" ]; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
else
    SCRIPT_PATH="$0"
fi

SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CLASH_DIR="${CLASH_DIR:-$PROJECT_DIR/mihomo}"
CLASH_BIN="${CLASH_BIN:-$CLASH_DIR/mihomo-linux-amd64-v1}"
CONFIG_FILE="${CLASH_CONFIG:-$CLASH_DIR/config.yaml}"
PID_FILE="${CLASH_PID:-$CLASH_DIR/mihomo.pid}"
LOG_FILE="${CLASH_LOG:-$CLASH_DIR/mihomo.log}"
TUI_DIR="${CLASH_TUI_DIR:-$PROJECT_DIR/tui}"
TUI_BIN_DIR="${CLASH_TUI_BIN_DIR:-$PROJECT_DIR/bin}"
TUI_BIN="$TUI_BIN_DIR/clash-tui"
STATE_LOCK_DIR="$CLASH_DIR/.clash.lock"
DEFAULT_PROXY_PORT=7890

return_or_exit() {
    local code="${1:-0}"
    return "$code" 2>/dev/null || exit "$code"
}

is_sourced() {
    [ "${BASH_SOURCE[0]:-}" != "$0" ] || [ -n "${ZSH_EVAL_CONTEXT:-}" ]
}

die() {
    echo "clash: $*" >&2
    return_or_exit 1
}

info() {
    echo "$*"
}

quiet() {
    [ "${CLASH_QUIET:-0}" = "1" ]
}

# #----状态锁----
acquire_state_lock() {
    local waited=0
    mkdir -p "$CLASH_DIR" || return 1
    while ! mkdir "$STATE_LOCK_DIR" 2>/dev/null; do
        waited=$((waited + 1))
        [ "$waited" -le 20 ] || die "clash 状态锁超时：$STATE_LOCK_DIR"
        sleep 0.2
    done
}

release_state_lock() {
    rmdir "$STATE_LOCK_DIR" 2>/dev/null || true
}

with_state_lock() {
    acquire_state_lock || return 1
    "$@"
    local code=$?
    release_state_lock
    return "$code"
}

# #----依赖与 YAML----
require_yq() {
    command -v yq >/dev/null 2>&1 || die "需要 yq。Debian/Ubuntu 可执行：sudo apt install yq"
}

yq_read() {
    command -v yq >/dev/null 2>&1 || return 1
    yq -r "$1" "$CONFIG_FILE"
}

yq_write() {
    require_yq || return 1
    local expr="$1"
    local tmp
    tmp="$(mktemp "$CONFIG_FILE.tmp.XXXXXX")" || return 1
    cp "$CONFIG_FILE" "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    if ! yq -i "$expr" "$tmp" >/dev/null 2>&1; then
        yq -y -i "$expr" "$tmp" >/dev/null 2>&1 || {
            rm -f "$tmp"
            return 1
        }
    fi
    yq_validate_file "$tmp" || {
        rm -f "$tmp"
        die "写入后的 YAML 校验失败，已保留原配置"
        return 1
    }
    mv "$tmp" "$CONFIG_FILE"
}

yq_validate_file() {
    command -v yq >/dev/null 2>&1 || return 1
    yq -r '.' "$1" >/dev/null 2>&1
}

require_valid_config() {
    require_yq || return 1
    if ! yq_validate_file "$CONFIG_FILE"; then
        die "config.yaml YAML 语法错误，请先运行：clash config clean"
        return 1
    fi
}

json_quote() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    printf '"%s"' "$value"
}

backup_config() {
    local stamp backup index
    stamp="$(date +%Y%m%d%H%M%S)"
    backup="$CONFIG_FILE.bak.$stamp"
    index=1
    while [ -e "$backup" ]; do
        backup="$CONFIG_FILE.bak.$stamp.$index"
        index=$((index + 1))
    done
    cp "$CONFIG_FILE" "$backup" || return 1
    info "Backup: $backup"
}

config_value() {
    local expr="$1"
    yq_read "$expr" 2>/dev/null | sed '/^null$/d'
}

reload_running_config() {
    is_running || return 0
    command -v curl >/dev/null 2>&1 || {
        die "mihomo 正在运行，但缺少 curl，无法热加载配置"
        return 1
    }

    local controller secret config_path payload response http_status body
    controller="$(config_value '."external-controller" // "127.0.0.1:9090"')"
    [ -n "$controller" ] || controller="127.0.0.1:9090"
    case "$controller" in
        http://*|https://*) ;;
        *) controller="http://$controller" ;;
    esac
    controller="${controller%/}"

    config_path="$(cd "$(dirname "$CONFIG_FILE")" && pwd)/$(basename "$CONFIG_FILE")"
    payload="{\"path\":$(json_quote "$config_path"),\"payload\":\"\"}"
    secret="$(config_value '.secret // ""')"

    if [ -n "$secret" ]; then
        response="$(curl --silent --show-error --noproxy '*' --connect-timeout 3 --max-time 30 \
            --request PUT \
            --header "Authorization: Bearer $secret" \
            --header "Content-Type: application/json" \
            --data "$payload" \
            --write-out $'\n%{http_code}' \
            "$controller/configs?force=true")" || return 1
    else
        response="$(curl --silent --show-error --noproxy '*' --connect-timeout 3 --max-time 30 \
            --request PUT \
            --header "Content-Type: application/json" \
            --data "$payload" \
            --write-out $'\n%{http_code}' \
            "$controller/configs?force=true")" || return 1
    fi

    http_status="${response##*$'\n'}"
    body="${response%$'\n'*}"
    case "$http_status" in
        2??) info "mihomo 配置已热加载" ;;
        *)
            [ -n "$body" ] || body="无响应内容"
            die "mihomo 热加载失败（HTTP $http_status）：$body"
            return 1
            ;;
    esac
}

fallback_tun_enabled() {
    awk '
        /^[[:space:]]*tun:[[:space:]]*$/ { in_tun = 1; next }
        in_tun && /^[^[:space:]]/ { in_tun = 0 }
        in_tun && /^[[:space:]]*enable:[[:space:]]*/ {
            gsub(/[[:space:]]/, "", $2)
            print $2
            exit
        }
    ' "$CONFIG_FILE" 2>/dev/null
}

proxy_port() {
    local port
    port="$(config_value '."mixed-port" // .port // 7890')"
    printf '%s' "${port:-$DEFAULT_PROXY_PORT}"
}

set_tun_enabled() {
    local enabled="$1"
    local tmp
    tmp="$(mktemp)" || return 1
    awk -v enabled="$enabled" '
        function indent_of(line, pos) {
            pos = match(line, /[^ ]/)
            return pos ? pos - 1 : length(line)
        }
        function spaces(count, out, i) {
            out = ""
            for (i = 0; i < count; i++) out = out " "
            return out
        }
        /^[[:space:]]*tun:[[:space:]]*$/ {
            print
            in_tun = 1
            seen_tun = 1
            changed = 0
            tun_indent = indent_of($0)
            child_prefix = spaces(tun_indent + 2)
            next
        }
        in_tun {
            current_indent = indent_of($0)
            if ($0 !~ /^[[:space:]]*$/ && current_indent <= tun_indent) {
                if (!changed) {
                    print child_prefix "enable: " enabled
                    changed = 1
                }
                in_tun = 0
            }
            if (in_tun && $0 ~ /^[[:space:]]*enable:[[:space:]]*/) {
                print child_prefix "enable: " enabled
                changed = 1
                next
            }
        }
        { print }
        END {
            if (in_tun && !changed) {
                print child_prefix "enable: " enabled
            }
            if (!seen_tun) {
                print ""
                print "tun:"
                print "  enable: " enabled
                print "  stack: system"
                print "  auto-route: true"
                print "  auto-detect-interface: true"
            }
        }
    ' "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
}

# #----运行状态----
pid_value() {
    [ -f "$PID_FILE" ] && tr -d '[:space:]' < "$PID_FILE"
}

is_running() {
    local pid
    pid="$(pid_value)"
    if [ -n "$pid" ] && ps -p "$pid" >/dev/null 2>&1; then
        return 0
    fi
    [ -n "$(own_mihomo_pids)" ]
}

own_mihomo_pids() {
    ps -eo pid=,args= | awk -v project="$PROJECT_DIR" -v work="$CLASH_DIR" '
        /mihomo/ && (index($0, "-d " work) || index($0, "-d " project)) {
            print $1
        }
    '
}

running_mode() {
    local tun
    tun="$(config_value '.tun.enable // false')"
    [ -n "$tun" ] || tun="$(fallback_tun_enabled)"
    if [ "$tun" = "true" ]; then
        printf 'tun'
    else
        printf 'normal'
    fi
}

short_status() {
    if is_running; then
        local pids
        pids="$(own_mihomo_pids | paste -sd, -)"
        [ -n "$pids" ] || pids="$(pid_value)"
        info "mihomo running | pid=$pids | mode=$(running_mode) | port=$(proxy_port)"
    else
        info "mihomo stopped | mode=$(running_mode) | port=$(proxy_port)"
    fi
}

status_detail() {
    short_status
    echo
    echo "Paths"
    echo "  project: $PROJECT_DIR"
    echo "  mihomo:  $CLASH_DIR"
    echo "  bin:     $CLASH_BIN"
    echo "  tui:     $TUI_BIN"
    echo "  config: $CONFIG_FILE"
    echo "  pid:     $PID_FILE"
    echo "  log:     $LOG_FILE"
    echo
    echo "Config"
    echo "  http:       $(config_value '.port // "-"')"
    echo "  mixed:      $(config_value '."mixed-port" // "-"')"
    echo "  socks:      $(config_value '."socks-port" // "-"')"
    echo "  controller: $(config_value '."external-controller" // "-"')"
    echo "  tun:        $(config_value '.tun.enable // false')"
    echo "  providers:  $(config_value '."proxy-providers" | keys | join(", ")' || true)"
    echo
    echo "Shell"
    echo "  http_proxy:  ${http_proxy:-"-"}"
    echo "  https_proxy: ${https_proxy:-"-"}"
    if [ -f "$LOG_FILE" ]; then
        echo
        echo "Log"
        echo "  size: $(du -h "$LOG_FILE" 2>/dev/null | awk '{print $1}')"
        echo "  time: $(stat -c '%y' "$LOG_FILE" 2>/dev/null | cut -d'.' -f1)"
    fi
}

# #----启停控制----
prepare_log_user() {
    if [ -e "$LOG_FILE" ] && [ ! -w "$LOG_FILE" ]; then
        sudo chown "$(id -u):$(id -g)" "$LOG_FILE" 2>/dev/null || sudo rm -f "$LOG_FILE"
    fi
    : > "$LOG_FILE" || return 1
}

export_proxy_env() {
    local port
    port="$(proxy_port)"
    export http_proxy="127.0.0.1:$port"
    export https_proxy="$http_proxy"
    export HTTP_PROXY="$http_proxy"
    export HTTPS_PROXY="$http_proxy"
}

unset_proxy_env() {
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
}

sync_env() {
    if is_running && [ "$(running_mode)" = "normal" ]; then
        export_proxy_env
        quiet || info "proxy env enabled: $http_proxy"
    else
        unset_proxy_env
        quiet || info "proxy env cleared"
    fi
}

start_normal() {
    [ -x "$CLASH_BIN" ] || die "mihomo 二进制不可执行：$CLASH_BIN"
    if is_running; then
        short_status
        return 0
    fi

    set_tun_enabled false || return 1
    prepare_log_user || die "无法写入日志：$LOG_FILE"
    nohup "$CLASH_BIN" -d "$CLASH_DIR" > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    export_proxy_env
    info "mihomo started (normal) | pid=$(pid_value) | proxy=$http_proxy"
}

start_tun() {
    [ -x "$CLASH_BIN" ] || die "mihomo 二进制不可执行：$CLASH_BIN"
    if is_running; then
        short_status
        return 0
    fi

    set_tun_enabled true || return 1
    info "[sudo] TUN 模式需要权限，正在验证..."
    sudo -v || return 1
    if is_running; then
        short_status
        return 0
    fi
    sudo bash -c "cd '$CLASH_DIR' && : > '$LOG_FILE' && nohup '$CLASH_BIN' -d '$CLASH_DIR' > '$LOG_FILE' 2>&1 & echo \$! > '$PID_FILE'"
    unset_proxy_env
    info "mihomo started (tun) | pid=$(pid_value)"
}

stop_clash() {
    local pids pid alive
    pids="$(own_mihomo_pids)"
    pid="$(pid_value)"
    if [ -n "$pid" ] && ps -p "$pid" >/dev/null 2>&1 && ! printf '%s\n' "$pids" | grep -qx "$pid"; then
        pids="${pids:+$pids
}$pid"
    fi

    if [ -z "$pids" ]; then
        info "mihomo already stopped"
    else
        info "Stopping mihomo pids: $(printf '%s\n' "$pids" | paste -sd, -)"
        while IFS= read -r pid; do
            [ -n "$pid" ] || continue
            kill "$pid" 2>/dev/null || sudo kill "$pid" 2>/dev/null || true
        done <<EOF
$pids
EOF
        sleep 1

        alive=""
        while IFS= read -r pid; do
            [ -n "$pid" ] || continue
            if ps -p "$pid" >/dev/null 2>&1; then
                alive="${alive:+$alive
}$pid"
            fi
        done <<EOF
$pids
EOF

        if [ -n "$alive" ]; then
            info "[sudo] 强制停止残留 mihomo：$(printf '%s\n' "$alive" | paste -sd, -)"
            while IFS= read -r pid; do
                [ -n "$pid" ] || continue
                kill -9 "$pid" 2>/dev/null || sudo kill -9 "$pid" 2>/dev/null || true
            done <<EOF
$alive
EOF
        fi
    fi

    rm -f "$PID_FILE" 2>/dev/null || sudo rm -f "$PID_FILE" 2>/dev/null
    unset_proxy_env
}

show_log() {
    if [ ! -f "$LOG_FILE" ]; then
        info "日志不存在：$LOG_FILE"
        return 0
    fi
    if command -v less >/dev/null 2>&1; then
        less +F "$LOG_FILE"
    else
        tail -f "$LOG_FILE"
    fi
}

# #----订阅配置----
usage_config() {
    cat <<'EOF'
用法：
  clash config add -n 名称 -u 订阅链接 [-p 保存路径]
  clash config ls
  clash config rm  -n 名称
  clash config clean

示例：
  clash config add -n airport -u https://example.com/sub.yaml
  clash config add -n airport -u https://example.com/sub.yaml -p /home/me/.config/mihomo/providers/airport.yaml
  clash config rm -n airport
  clash config clean
EOF
}

is_blank_value() {
    [ -z "$(printf '%s' "${1:-}" | tr -d '[:space:]')" ]
}

require_option_value() {
    local opt="$1"
    local value="${2-}"
    if [ "$#" -lt 2 ] || is_blank_value "$value"; then
        die "参数 $opt 需要非空值"
        return 1
    fi
    case "$value" in
        -*) die "参数 $opt 需要非空值，收到疑似选项：$value"; return 1 ;;
    esac
}

config_add() {
    local name="" url="" provider_path=""
    case "${1:-}" in
        -h|--help) usage_config; return 0 ;;
    esac
    if [ "$#" -lt 4 ]; then
        usage_config
        die "config add 至少需要：-n 名称 -u 订阅链接"
        return 1
    fi
    if [ $(( $# % 2 )) -ne 0 ]; then
        usage_config
        die "config add 参数不完整，请检查是否缺少某个选项值"
        return 1
    fi
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage_config; return 0 ;;
            -n|--name) require_option_value "$1" "${2-}" || return 1; name="$2"; shift 2 ;;
            -u|--url) require_option_value "$1" "${2-}" || return 1; url="$2"; shift 2 ;;
            -p|--path) require_option_value "$1" "${2-}" || return 1; provider_path="$2"; shift 2 ;;
            *) usage_config; return 1 ;;
        esac
    done
    if is_blank_value "$name"; then
        die "缺少订阅名：-n/--name"
        return 1
    fi
    if is_blank_value "$url"; then
        die "缺少订阅链接：-u/--url"
        return 1
    fi
    [ -n "$provider_path" ] || provider_path="./providers/$name.yaml"
    if is_blank_value "$provider_path"; then
        die "订阅保存路径不能为空：-p/--path"
        return 1
    fi

    require_valid_config || return 1
    mkdir -p "$CLASH_DIR/providers"
    backup_config || return 1
    config_sanitize || return 1

    local q_name q_url q_path q_prefix
    q_name="$(json_quote "$name")"
    q_url="$(json_quote "$url")"
    q_path="$(json_quote "$provider_path")"
    q_prefix="$(json_quote "[$name]")"

    yq_write ".\"proxy-providers\"[$q_name] = {
        \"type\": \"http\",
        \"interval\": 3600,
        \"health-check\": {
          \"enable\": true,
          \"url\": \"https://cp.cloudflare.com\",
          \"interval\": 300,
          \"timeout\": 1000,
          \"tolerance\": 100
        },
        \"url\": $q_url,
        \"path\": $q_path,
        \"override\": {\"additional-prefix\": $q_prefix}
      } |
      (.\"proxy-groups\"[] | select(.name == \"自动选择\").use) |= (((. // []) + [$q_name]) | unique) |
      (.\"proxy-groups\"[] | select(.name == \"全部节点\").use) |= (((. // []) + [$q_name]) | unique)" || return 1

    reload_running_config || {
        die "Provider 已写入 config.yaml，但运行中的 mihomo 未能加载新配置"
        return 1
    }
    info "Provider added: $name"
    info "Path: $provider_path"
}

config_ls() {
    require_yq || return 1
    yq -r '."proxy-providers" // {} | to_entries[] | "\(.key)\t\(.value.url // "-")"' "$CONFIG_FILE" |
        awk -F '\t' '
            BEGIN { max = 4 }
            {
                rows[++count] = $0
                if (length($1) > max) max = length($1)
            }
            END {
                printf "%-*s   %s\n", max, "NAME", "URL"
                printf "%-*s   %s\n", max, "----", "---"
                for (i = 1; i <= count; i++) {
                    split(rows[i], cols, "\t")
                    printf "%-*s   %s\n", max, cols[1], cols[2]
                }
            }'
}

config_rm() {
    local name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage_config; return 0 ;;
            -n|--name) require_option_value "$1" "${2-}" || return 1; name="$2"; shift 2 ;;
            -u|--url|-p|--path) require_option_value "$1" "${2-}" || return 1; shift 2 ;;
            *) usage_config; return 1 ;;
        esac
    done
    if is_blank_value "$name"; then
        die "缺少订阅名：-n/--name"
        return 1
    fi

    require_valid_config || return 1
    backup_config || return 1
    local q_name
    q_name="$(json_quote "$name")"
    yq_write "del(.\"proxy-providers\"[$q_name]) |
      (.\"proxy-groups\"[]?.use) |= ((. // []) - [$q_name])" || return 1
    info "Provider removed: $name"
}

config_sanitize() {
    local expr
    expr='
      ."proxy-providers" = (
        (."proxy-providers" // {}) |
        with_entries(
          select(
            ((.key | tostring | gsub("\\s"; "")) != "") and
            ((.value.url // "" | tostring | gsub("\\s"; "")) != "")
          )
        )
      ) |
      (."proxy-providers" | keys) as $provider_names |
      if ."proxy-groups"? then
        ."proxy-groups" |= map(
          if has("use") then
            .use |= ((. // []) | map(select((. | tostring | gsub("\\s"; "")) != "")) | map(select(. as $name | ($provider_names | index($name)) != null)))
          else . end
        )
      else . end |
      if (.use? | type) == "object" and (.use.use? | type) == "array" then
        .use.use |= ((. // []) | map(select((. | tostring | gsub("\\s"; "")) != "")) | map(select(. as $name | ($provider_names | index($name)) != null)))
      else . end
    '
    yq_write "$expr"
}

restore_valid_config_from_backup() {
    local backup
    while IFS= read -r backup; do
        [ -n "$backup" ] || continue
        if yq_validate_file "$backup"; then
            cp "$backup" "$CONFIG_FILE" || return 1
            info "已从可解析备份恢复：$backup"
            return 0
        fi
    done <<EOF
$(find "$CLASH_DIR" -maxdepth 1 -type f -name 'config.yaml.bak*' 2>/dev/null | sort -r)
EOF
    return 1
}

restore_config_from_example() {
    local example="$CLASH_DIR/example.config.yaml"
    [ -f "$example" ] || return 1
    yq_validate_file "$example" || return 1
    cp "$example" "$CONFIG_FILE" || return 1
    info "未找到可解析备份，已使用 example.config.yaml 重建基础配置"
}

config_clean() {
    require_yq || return 1

    if ! yq_validate_file "$CONFIG_FILE"; then
        info "config.yaml YAML 语法错误，尝试从备份恢复..."
        restore_valid_config_from_backup || restore_config_from_example || die "无法自动修复 config.yaml 语法错误"
    fi

    config_sanitize || return 1
    if ! yq_validate_file "$CONFIG_FILE"; then
        die "清理后 YAML 校验失败"
        return 1
    fi

    if [ -d "$CLASH_DIR/providers" ]; then
        find "$CLASH_DIR/providers" -mindepth 1 -maxdepth 1 -type f \( -name '*.yaml' -o -name '*.yml' \) -delete
        info "已移除 providers 缓存：$CLASH_DIR/providers"
    fi
    find "$CLASH_DIR" -maxdepth 1 -type f -name 'config.yaml.bak*' -delete
    info "已移除 config.yaml.bak 缓存"
    info "config.yaml clean 完成"
}

config_cmd() {
    local sub="${1:-}"
    shift || true
    case "$sub" in
        add) config_add "$@" ;;
        ls|list) config_ls ;;
        rm|remove) config_rm "$@" ;;
        clean) config_clean ;;
        -h|--help|help) usage_config ;;
        *) usage_config; return 1 ;;
    esac
}

# #----TUI----
usage_tui() {
    cat <<'EOF'
Usage:
  clash tui [ARGS]    Run the built TUI binary, forwarding ARGS
  clash tui --dev     Run TUI through cargo run
  clash tui --build   Build TUI release binary
  clash tui --clean   Clean TUI cargo cache only
  clash tui --download rustup
  clash tui --download VERSION [--github|--gitea]
EOF
}

require_tui_dir() {
    [ -d "$TUI_DIR" ] || die "TUI 目录不存在：$TUI_DIR"
    [ -f "$TUI_DIR/Cargo.toml" ] || die "TUI Cargo.toml 不存在：$TUI_DIR/Cargo.toml"
}

require_cargo() {
    command -v cargo >/dev/null 2>&1 || die "需要 cargo 才能构建或开发运行 TUI"
}

tui_dev() {
    require_tui_dir || return 1
    require_cargo || return 1
    if [ "$#" -eq 0 ]; then
        set -- -d "$CLASH_DIR"
    fi
    (cd "$TUI_DIR" && cargo run -- "$@")
}

tui_build() {
    require_tui_dir || return 1
    require_cargo || return 1

    (cd "$TUI_DIR" && cargo build --release) || return 1
    mkdir -p "$TUI_BIN_DIR" || return 1
    cp "$TUI_DIR/target/release/clash-tui" "$TUI_BIN" || return 1
    chmod +x "$TUI_BIN" || return 1
    info "TUI built: $TUI_BIN"
}

tui_run() {
    require_tui_dir || return 1
    [ -x "$TUI_BIN" ] || die "TUI 尚未安装：请先运行 clash tui --build 或 ./shell/download.sh"
    if [ "$#" -eq 0 ]; then
        set -- -d "$CLASH_DIR"
    fi
    (cd "$TUI_DIR" && "$TUI_BIN" "$@")
}

tui_clean() {
    require_tui_dir || return 1
    require_cargo || return 1

    (cd "$TUI_DIR" && cargo clean) || return 1
    info "TUI cargo cache cleaned"
}

tui_download() {
    "$SCRIPT_DIR/download.sh" "$@"
}

tui_cmd() {
    local opt="${1:-}"
    case "$opt" in
        "") tui_run ;;
        --dev) shift; tui_dev "$@" ;;
        --build) tui_build ;;
        --clean) tui_clean ;;
        --download) shift; tui_download "$@" ;;
        -h|--help|help) usage_tui ;;
        *) tui_run "$@" ;;
    esac
}

# #----帮助----
usage() {
    cat <<'EOF'
用法：
  clash                 显示简要状态
  clash status          显示详细状态
  clash on              普通模式启动 mihomo，并导出代理环境变量
  clash tun             TUN 模式启动 mihomo，会先进行 sudo 验证
  clash off             停止 mihomo，并清理代理环境变量
  clash env             根据 mihomo 状态同步当前 shell 的代理环境变量
  clash log             使用 less +F 跟随 mihomo.log
  clash tui             运行、构建或开发终端界面
  clash config add      添加订阅 Provider 到 config.yaml
  clash config ls       列出订阅 Provider 名称和链接
  clash config rm       从 config.yaml 移除订阅 Provider
  clash config clean    修复并清理订阅配置缓存

更多帮助：
  clash tui -h
  clash config -h
EOF
}

# #----主入口----
main() {
    local cmd="${1:-}"
    if [ $# -gt 0 ]; then
        shift
    fi

    case "$cmd" in
        "") short_status ;;
        on) with_state_lock start_normal ;;
        tun) with_state_lock start_tun ;;
        off) with_state_lock stop_clash ;;
        env) sync_env ;;
        status) status_detail ;;
        log) show_log ;;
        tui) tui_cmd "$@" ;;
        config) config_cmd "$@" ;;
        help|-h|--help) usage ;;
        *) usage; return 1 ;;
    esac
}

main "$@"
